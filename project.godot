[application]
config/name="Battle or Die"
config/description="A replayable armored-combat campaign with distinct vehicles, objectives, progression and tactical damage."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.045, 1)

[autoload]
GameState="*res://scripts/GameState.gd"

[input]
move_forward={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_backward={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83)]}
turn_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":65)]}
turn_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":68)]}
turret_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":81)]}
turret_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":69)]}
fire={"deadzone":0.5,"events":[Object(InputEventMouseButton,"button_index":1)]}
repair={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":70)]}
ability={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32)]}
xray={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":88)]}
garage={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":71)]}

[physics]
common/physics_ticks_per_second=60
common/physics_jitter_fix=0.5

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Tanks"
3d_physics/layer_3="Projectiles"
