; Engine configuration file.
; Glory or Die - armored vehicle simulation foundation
; Godot 4.x / Compatibility renderer

config_version=5

[application]
config/name="Glory or Die"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
GameState="*res://scripts/GameState.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
3d/default_gravity=9.80665

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_backward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
turn_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
turn_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
turret_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
turret_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
fire={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
repair={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
